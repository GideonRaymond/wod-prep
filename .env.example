ANTHROPIC_API_KEY=

# Movement videos (YouTube Data API v3). Without it the workout page shows a short note instead of videos.
YOUTUBE_API_KEY=

# Production: one shared password for the whole site (the browser asks for it). Leave empty to keep it open.
SITE_PASSWORD=

# Production: the Upstash Redis database for the shared cache and per-visitor rate limits.
# Without it, results are cached in .cache/ (development only) and limits are counted per server.
# Vercel's integration sets KV_REST_API_URL and KV_REST_API_TOKEN instead; both names work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Claude results are cached in .cache/ in development (off in production, where Redis is used).
# WOD_CACHE=on|off

# Make cached results arrive as slowly as real ones (development only), to test the loading screens.
# MOCK_LOAD=true
