ANTHROPIC_API_KEY=

# Movement videos (YouTube Data API v3). Without it the workout page shows a short note instead of videos.
YOUTUBE_API_KEY=

# Claude results are cached in .cache/ in development (off in production).
# WOD_CACHE=on|off

# Make cached results arrive as slowly as real ones (development only), to test the loading screens.
# MOCK_LOAD=true
